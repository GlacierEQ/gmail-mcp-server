{
  "name": "@gongrzhe/server-gmail-autoauth-mcp",
  "version": "1.1.11",
  "description": "Gmail MCP server with GlacierEQ operational reconciliation extensions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gmail-mcp": "./dist/index.js",
    "gmail-ops-mcp": "./dist/ops-index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node dist/evals/reconcile-email-state.test.js && node dist/evals/email-operations-pipeline.test.js",
    "start": "node dist/index.js",
    "start:ops": "node dist/ops-index.js",
    "auth": "node dist/index.js auth",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "gmail",
    "mcp",
    "cursor",
    "ai",
    "oauth",
    "model-context-protocol",
    "google-gmail",
    "claude",
    "auto-auth",
    "email-operations",
    "response-reconciliation"
  ],
  "author": "gongrzhe",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongrzhe/server-gmail-autoauth-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gongrzhe/server-gmail-autoauth-mcp/issues"
  },
  "homepage": "https://github.com/gongrzhe/server-gmail-autoauth-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@types/mime-types": "^2.1.4",
    "google-auth-library": "^9.4.1",
